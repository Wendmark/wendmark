# Copy to .env and adjust. Never commit .env.
#
# Postgres connection for the portal. The compose file in the repo root
# starts one on port 5433 so it does not clash with other databases you
# may already be running.
DATABASE_URL="postgresql://wendmark:wendmark@localhost:5433/wendmark?schema=public"

# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Single sign-on (optional). Set all three to enable a "Sign in with..."
# button. Works with any OpenID Connect provider.
# OIDC_ISSUER="https://login.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_NAME="Example SSO"
