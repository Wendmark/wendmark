{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@wendmark/snippet#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/dom/src/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/portal/public/snippet.js",
        "$TURBO_ROOT$/apps/portal/public/author.js"
      ]
    },
    "@wendmark/portal#build": {
      "dependsOn": ["^build", "@wendmark/snippet#build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
