# Wendmark environment variables. Copy to `.env` (gitignored) and fill in.
# Nothing is required yet — the scaffold runs with no configuration.
#
# Rule: anything prefixed NEXT_PUBLIC_ or VITE_ is inlined into client
# bundles at build time and is PUBLIC. Never put secrets behind those
# prefixes. (The legacy prototype shipped an API key this way — don't repeat it.)

# Public base URL of the portal; the snippet will load flows from here.
# NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
