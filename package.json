{
  "name": "wendmark",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@wendmark/portal --filter=@wendmark/playground --filter=@wendmark/snippet",
    "build": "turbo run build",
    "test": "turbo run test && vitest run --config scripts/vitest.config.ts",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "size": "turbo run build --filter=@wendmark/snippet && node scripts/size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^22",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "^4.4",
    "eslint-plugin-boundaries": "^7.2",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "prettier": "^3.9",
    "turbo": "^2.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70",
    "vitest": "^5"
  }
}
