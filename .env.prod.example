# Settings for docker-compose.prod.yml. Copy to .env.prod and fill in.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# .env.prod is gitignored. Never commit it.

# The database password. There is no default on purpose: compose refuses to
# start without one rather than giving you a Postgres anybody could reach.
POSTGRES_PASSWORD=

# Signs session cookies. Generate one with:
#   openssl rand -base64 32
# Changing it signs everybody out.
AUTH_SECRET=

# The address people actually reach the portal on, including the scheme.
# The portal sits behind your proxy and cannot work this out from a request.
# It is also the address the snippet is served from, so it must be reachable
# from your customers' pages.
AUTH_URL=https://wendmark.example.com

# Where to publish the portal on the host. Put a proxy in front of it for
# TLS — see docs/deploying.md.
PORTAL_PORT=3100

# Optional: Postgres user and database name.
# POSTGRES_USER=wendmark
# POSTGRES_DB=wendmark

# Optional: single sign-on. Set all three to add a "Sign in with..." button.
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Example SSO
